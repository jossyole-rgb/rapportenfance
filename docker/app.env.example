# Copier vers docker/app.env (non versionné). Voir .env.example pour le détail de chaque variable.
# Le mot de passe doit être identique à POSTGRES_PASSWORD de docker/db.env.
DATABASE_URL=postgresql://rapport:CHANGE_ME@db:5432/rapportenfance?schema=public
APP_URL=https://rapportenfance.exemple.fr
# npm run keys:generate (sur un poste de confiance) ; conserver une copie hors ligne
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=v1
DATA_ENCRYPTION_KEYS_PREVIOUS=
SESSION_MAX_AGE_HOURS=10
SESSION_IDLE_TIMEOUT_MINUTES=30
PLATFORM_MFA_REQUIRED=true
AI_PROVIDER=local
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
MAIL_FROM=RapportEnfance IA <no-reply@exemple.fr>
