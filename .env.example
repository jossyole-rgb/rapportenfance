# ---------------------------------------------------------------------------
# RapportEnfance IA - variables d'environnement (exemple SANS secrets)
# Copier vers .env puis renseigner. Ne jamais versionner le fichier .env.
# ---------------------------------------------------------------------------

# Base PostgreSQL (utiliser sslmode=require en production)
DATABASE_URL="postgresql://rapport:CHANGE_ME@localhost:5432/rapportenfance?schema=public"

# URL publique de l'application (liens d'invitation et de réinitialisation)
APP_URL="http://localhost:3000"

# Clé de chiffrement applicatif des données sensibles : 32 octets en base64.
# Générer avec : npm run keys:generate
# La perte de cette clé rend les notes et rapports illisibles : la conserver dans un coffre-fort de secrets.
DATA_ENCRYPTION_KEY=""
# Clés précédentes (rotation), format "v1:BASE64,v2:BASE64". Optionnel.
DATA_ENCRYPTION_KEYS_PREVIOUS=""
# Identifiant de la clé courante (préfixe des valeurs chiffrées)
DATA_ENCRYPTION_KEY_ID="v1"

# Sessions
SESSION_MAX_AGE_HOURS=10
SESSION_IDLE_TIMEOUT_MINUTES=30

# Double authentification obligatoire pour les administrateurs techniques (sans établissement).
# Pour les utilisateurs d'un établissement, le réglage se fait dans les paramètres de l'établissement.
# Ne mettre "false" que sur un poste de démonstration.
PLATFORM_MFA_REQUIRED="true"

# Moteur de rédaction. Seule valeur disponible dans le MVP : "local"
# (moteur déterministe exécuté sur le serveur, aucun appel à un service tiers).
# Aucun fournisseur IA externe n'est autorisé tant que le cadre (DPO, AIPD, contrat) n'est pas validé.
AI_PROVIDER="local"

# E-mails (invitations, réinitialisation). Sans SMTP_URL, les e-mails sont écrits
# dans le dossier .dev-mailbox/ (développement uniquement, refusé en production).
SMTP_URL=""
MAIL_FROM="RapportEnfance IA <no-reply@example.org>"
