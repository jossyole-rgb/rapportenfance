{
  "name": "rapportenfance-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Assistant de rédaction sécurisé pour les professionnels de la protection de l'enfance (MVP).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run db:test:prepare --silent && vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "retention:purge": "tsx scripts/retention-purge.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "admin": "tsx scripts/admin.ts",
    "keys:reencrypt": "tsx scripts/rotate-keys.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "docx": "^9.11.0",
    "lucide-react": "^0.544.0",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.1",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
